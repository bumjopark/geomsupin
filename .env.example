DATABASE_URL=postgresql://geomsupin_app:CHANGE_ME@127.0.0.1:55433/geomsupin
TEST_DATABASE_URL=postgresql://geomsupin_app:CHANGE_ME@127.0.0.1:55433/geomsupin_test
PORT=8200
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8200
ALLOWED_HOSTS=127.0.0.1:8200,localhost:8200
DATA_DIR=./data
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 이미지 프록시(/api/w/img): CORS 없는 사이트의 이미지를 서버가 대신 받아 캡처에 담는다. 끄려면 false
IMAGE_PROXY_ENABLED=true
# 통합 백업: 기본 DATA_DIR/backups, 야간·수동·배포 전 각각 최근 14개 보존
# BACKUP_DIR=/mnt/backup/geomsupin
# 추가 외부 복사: 미리 마운트한 폴더만 사용(미설정이면 로컬 백업만)
# BACKUP_MIRROR_DIR=/mnt/nas/geomsupin

# 실제 Edge 모달 회귀를 npm run check에 포함(실행 파일의 절대 경로)
# PLAYWRIGHT_EDGE_EXECUTABLE=/opt/microsoft/msedge/msedge

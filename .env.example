# These are local HTTP development settings. For the team's HTTPS service on port 3443, use the installer in the README.
# 로컬 HTTP 개발용 예시입니다. 팀에서 쓸 HTTPS 3443 서비스는 README의 설치 절차로 구성하세요.
# The installer generates credentials. Replace the placeholders below if configuring .env by hand.
# 설치기는 자격증명을 생성합니다. 직접 구성할 때는 아래 예시 값을 실제 설정으로 바꾸세요.
DATABASE_URL=postgresql://geomsupin_app:CHANGE_ME@127.0.0.1:55433/geomsupin
TEST_DATABASE_URL=postgresql://geomsupin_app:CHANGE_ME@127.0.0.1:55433/geomsupin_test
PORT=8200
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8200
ALLOWED_HOSTS=127.0.0.1:8200,localhost:8200
DATA_DIR=./data
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# The image proxy can fetch public images that the browser cannot read for a screenshot. Set to false to disable it.
# 이미지 프록시는 브라우저가 캡처에 넣을 수 없는 공개 이미지를 대신 가져옵니다. 끄려면 false로 설정하세요.
IMAGE_PROXY_ENABLED=true
# Backups default to DATA_DIR/backups. The latest 14 scheduled, manual, and pre-deployment backups are retained per type.
# 백업은 기본적으로 DATA_DIR/backups에 저장하며 야간·수동·배포 전 백업을 종류별로 최근 14개씩 보존합니다.
# BACKUP_DIR=/mnt/backup/geomsupin
# Set this to an already mounted directory to mirror backups. Leave it unset for local backups only.
# 백업 사본을 둘 외부 디렉터리를 미리 마운트한 뒤 지정하세요. 생략하면 로컬에만 저장합니다.
# BACKUP_MIRROR_DIR=/mnt/nas/geomsupin

# Set the absolute path to Microsoft Edge to include its modal tests in npm run check.
# Edge 모달 시험을 npm run check에 포함하려면 실행 파일의 절대 경로를 지정하세요.
# PLAYWRIGHT_EDGE_EXECUTABLE=/opt/microsoft/msedge/msedge
